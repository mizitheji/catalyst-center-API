# Catalyst Center connection settings
# Copy this file to .env, fill in your values, then: chmod 600 .env
# Lines starting with # are ignored.
# If a value contains " #" or quote characters, wrap it in quotes.

DNAC_HOST=192.168.1.1          # IP/hostname, optionally :port (e.g. 10.0.0.5:443)
DNAC_USERNAME=admin
DNAC_PASSWORD=yourpassword

# --- Optional ---
# TLS: verification is OFF by default (self-signed certs). Turn it on with either:
# DNAC_VERIFY_SSL=true
# DNAC_CA_BUNDLE=/path/to/ca-bundle.pem
#
# Open Issues look-back window in days (default 7)
# DNAC_ISSUE_DAYS=7
#
# Print full tracebacks on unexpected errors
# DNAC_DEBUG=1